rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Collection: usuarios
    match /usuarios/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: solicitudesVinculacion
    match /solicitudesVinculacion/{solicitudId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: vinculos
    match /vinculos/{vinculoId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: rutinasAsignadas
    match /rutinasAsignadas/{asignacionId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: ejercicios
    match /ejercicios/{ejercicioId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: rutinas
    match /rutinas/{rutinaId} {
      allow read, write: if isAuthenticated();
    }

    // Collection: entrenamientos
    match /entrenamientos/{entrenamientoId} {
      allow read, write: if isAuthenticated();
      
      match /registrosEjercicio/{registroId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Collection: validacionesDiarias
    match /validacionesDiarias/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // Subcollections fallback
    match /{path=**}/registrosPeso/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
